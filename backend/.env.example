# Required: the backend refuses to start if any of these is missing.
SECRET_KEY=
ALLOWED_HOSTS=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# SeaweedFS (S3). Inside Compose, S3_ENDPOINT is set to http://seaweedfs:8333 and the three below
# come from the root .env, so these values matter only when running the backend on the host.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Redis broker for Celery. Inside Compose it is set to redis://redis:6379/0.
CELERY_BROKER_URL=
# Worker only (Compose sets it from the root .env): the commit of the embedding model to load.
# The reviewed revision is in docs/specs/FEAT-20261103-1300 of the tracking repo.
# EMBED_MODEL_REVISION=
