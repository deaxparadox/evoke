# Required: the backend refuses to start if any of these is missing.
SECRET_KEY=
ALLOWED_HOSTS=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# SeaweedFS (S3). Inside Compose, S3_ENDPOINT is set to http://seaweedfs:8333 and the three below
# come from the root .env, so these values matter only when running the backend on the host.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
