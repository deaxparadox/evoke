# Compose-level values, read by docker compose for the services below. Copy to .env and fill in.
# Required: Compose stops if any is empty or missing.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# Commit hash of the embedding model (voyageai/voyage-4-nano) the worker loads. Required, no default (ADR 0004).
EMBED_MODEL_REVISION=

# Optional: host port for Postgres (default 5432). Change it if 5432 is taken on your machine.
# POSTGRES_HOST_PORT=5434

# Optional: memory limit of the worker container (default 4g). A parse that goes over is killed and its page marked failed.
# WORKER_MEMORY_LIMIT=4g
